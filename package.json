{
  "name": "mandato-simulation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motor determinista de simulación política para MANDATO",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run data:sync && tsc -p tsconfig.json && vite build && node scripts/build-credits.mjs && node scripts/build-offline-manifest.mjs",
    "build:web": "npm run data:sync && vite build && node scripts/build-credits.mjs && node scripts/build-offline-manifest.mjs",
    "data:sync": "node scripts/sync-country-profiles.mjs",
    "data:check": "node scripts/sync-country-profiles.mjs --check",
    "build:worker-check": "tsc -p tsconfig.worker.json",
    "build:repro-check": "node scripts/check-build-reproducibility.mjs",
    "test": "tsx --test tests/**/*.test.ts",
    "sim": "node --import tsx src/cli/index.ts",
    "validate:mass": "tsx src/cli/index.ts --country peru --years 20 --runs 1000 --seed mandato-phase-0",
    "validate:career": "tsx src/cli/career-mass.ts 1000",
    "validate:government": "tsx src/cli/government-mass.ts",
    "validate:countries": "tsx src/cli/country-batch.ts",
    "validate:balance": "tsx src/cli/career-balance.ts",
    "content:validate": "tsx src/cli/content-audit.ts",
    "calibrate:phase3": "tsx src/cli/economic-calibration.ts",
    "world:update-data": "node scripts/update-world-data.mjs",
    "world:validate": "tsx src/cli/world-mass.ts 100",
    "world:sensitivity": "tsx src/cli/world-sensitivity.ts",
    "world:frequency": "tsx src/cli/world-frequency.ts",
    "world:shock-frequency": "tsx src/cli/shock-frequency.ts",
    "validate:generated": "tsx src/cli/generated-countries.ts",
    "validate:diplomacy": "tsx src/cli/diplomacy-balance.ts",
    "validate:long-career": "node --expose-gc --import tsx src/cli/long-career.ts"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
